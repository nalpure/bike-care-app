{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bike-app.invalid/schema/steps.schema.json",
  "title": "content/steps/*.yaml: shared cards, used by more than one job or by a procedure",
  "type": "object",
  "properties": {
    "steps": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/card" }
    }
  },
  "required": ["steps"],
  "additionalProperties": false
}
