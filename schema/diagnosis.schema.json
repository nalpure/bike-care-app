{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bike-app.invalid/schema/diagnosis.schema.json",
  "title": "content/diagnoses/*.yaml: one symptom",
  "type": "object",
  "properties": {
    "diagnosis": {
      "type": "object",
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "symptom": { "$ref": "common.schema.json#/$defs/text" },
        "params": { "$ref": "common.schema.json#/$defs/params" },
        "covers_like": {
          "description": "A job whose covers this diagnosis uses: it runs only for the bikes that job covers, and ends with the job's not_covered texts for the others.",
          "$ref": "common.schema.json#/$defs/id"
        },
        "checks": {
          "description": "Cheapest and most likely first. The first state that leads to a job ends the diagnosis.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "inspect": { "$ref": "common.schema.json#/$defs/id" },
              "override": {
                "description": "Per state: a different job and urgency, or null for not a hit.",
                "type": "object",
                "additionalProperties": {
                  "anyOf": [{ "$ref": "common.schema.json#/$defs/leadsTo" }, { "type": "null" }]
                }
              }
            },
            "required": ["inspect"],
            "additionalProperties": false
          }
        },
        "no_hit": {
          "type": "object",
          "properties": { "job": { "$ref": "common.schema.json#/$defs/id" } },
          "required": ["job"],
          "additionalProperties": false
        }
      },
      "required": ["id", "symptom", "checks", "no_hit"],
      "additionalProperties": false
    }
  },
  "required": ["diagnosis"],
  "additionalProperties": false
}
