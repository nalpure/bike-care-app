{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bike-app.invalid/schema/check.schema.json",
  "title": "content/checks/*.yaml: the routine check",
  "type": "object",
  "properties": {
    "check": {
      "type": "object",
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "title": { "$ref": "common.schema.json#/$defs/text" },
        "inspections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "inspect": { "$ref": "common.schema.json#/$defs/id" },
              "pos": { "type": "array", "minItems": 1, "items": { "enum": ["front", "rear"] } }
            },
            "required": ["inspect"],
            "additionalProperties": false
          }
        }
      },
      "required": ["id", "title", "inspections"],
      "additionalProperties": false
    }
  },
  "required": ["check"],
  "additionalProperties": false
}
