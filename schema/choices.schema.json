{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bike-app.invalid/schema/choices.schema.json",
  "title": "content/choices.yaml: choices the user makes fresh for each run, never stored on the bike",
  "type": "object",
  "properties": {
    "choices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "question": { "$ref": "common.schema.json#/$defs/text" },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
                "label": { "$ref": "common.schema.json#/$defs/text" },
                "note": { "$ref": "common.schema.json#/$defs/text" },
                "warning": { "$ref": "common.schema.json#/$defs/text" },
                "recommended": { "type": "boolean" },
                "requires_tools": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" } }
              },
              "required": ["id", "label"],
              "additionalProperties": false
            }
          }
        },
        "required": ["id", "question", "options"],
        "additionalProperties": false
      }
    }
  },
  "required": ["choices"],
  "additionalProperties": false
}
