{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bike-app.invalid/schema/facts.schema.json",
  "title": "content/facts.yaml: lasting properties of a bike",
  "type": "object",
  "properties": {
    "fact_groups": {
      "description": "One entry per group. A fact's group is the part of its key before the first dot (bike, drive, geometry). The garage shows the groups with their icons.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "label": {
            "type": "object",
            "properties": {
              "en": { "$ref": "common.schema.json#/$defs/text" },
              "de": { "$ref": "common.schema.json#/$defs/text" }
            },
            "required": ["en"],
            "additionalProperties": false
          },
          "icon": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "description": "Icon id. The app draws the icon." }
        },
        "required": ["id", "label", "icon"],
        "additionalProperties": false
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": { "$ref": "common.schema.json#/$defs/factKey" },
          "type": { "enum": ["enum", "boolean", "text", "number"] },
          "label": {
            "description": "Short name for lists, such as the bike sheet: \"Gears\", \"Rear derailleur\".",
            "type": "object",
            "properties": {
              "en": { "$ref": "common.schema.json#/$defs/text" },
              "de": { "$ref": "common.schema.json#/$defs/text" }
            },
            "required": ["en"],
            "additionalProperties": false
          },
          "values": { "type": "array", "minItems": 2, "items": { "type": ["string", "integer"] }, "description": "enum: the values. number: the only values allowed, when the number comes from a fixed list." },
          "unit": { "enum": ["mm", "deg"], "description": "number only: unit of the value, shown after it." },
          "min": { "type": "number", "description": "number only: lowest plausible value. The app refuses values below it." },
          "max": { "type": "number", "description": "number only: highest plausible value. The app refuses values above it." },
          "question": {
            "description": "Beginner question. Required for every fact that a condition reads, because only those are asked.",
            "type": "object",
            "properties": {
              "en": { "$ref": "common.schema.json#/$defs/text" },
              "de": { "$ref": "common.schema.json#/$defs/text" },
              "picture": { "type": "string", "description": "Name of the picture set shown with the answers." }
            },
            "required": ["en"],
            "additionalProperties": false
          },
          "help": {
            "description": "Optional longer help behind a '?' next to the question: how to tell the answers apart. The app adds its own last line pointing to the assistant; do not write it here.",
            "type": "object",
            "properties": {
              "en": { "$ref": "common.schema.json#/$defs/text" },
              "de": { "$ref": "common.schema.json#/$defs/text" }
            },
            "required": ["en"],
            "additionalProperties": false
          },
          "answers": {
            "description": "The answer button for each value, in the user's words.",
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "en": { "$ref": "common.schema.json#/$defs/text" },
                "de": { "$ref": "common.schema.json#/$defs/text" }
              },
              "required": ["en"],
              "additionalProperties": false
            }
          },
          "ask": {
            "description": "when_needed (default): asked when a condition reads it. never: conditions may read it, but the app never asks; it is unknown unless the bike's data (parts list, partner, lookup) provides it. Use never for facts a beginner cannot tell.",
            "enum": ["when_needed", "never"]
          },
          "safety": { "type": "boolean" },
          "note": { "type": "string", "description": "For authors. Never shown." }
        },
        "required": ["key", "type", "label", "safety"],
        "additionalProperties": false,
        "allOf": [
          { "if": { "properties": { "type": { "const": "enum" } } }, "then": { "required": ["values"] } },
          {
            "if": { "properties": { "type": { "const": "number" } } },
            "then": { "properties": { "values": { "type": "array", "items": { "type": "integer" } } } },
            "else": { "properties": { "unit": false, "min": false, "max": false } }
          }
        ]
      }
    }
  },
  "required": ["fact_groups", "facts"],
  "additionalProperties": false
}
