{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bike-app.invalid/schema/tools.schema.json",
  "title": "content/tools.yaml: tool catalog and parts",
  "type": "object",
  "properties": {
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "name": { "$ref": "common.schema.json#/$defs/text" },
          "kind": { "enum": ["tool", "consumable"] },
          "mentions": {
            "description": "Short words a step text may use for this tool instead of its full name, such as 'stand' for 'Bike work stand'. A step lists a tool only when its text names it (rule tool-not-mentioned).",
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 2 }
          },
          "substitutes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "$ref": "common.schema.json#/$defs/text" },
                "note": { "$ref": "common.schema.json#/$defs/text" }
              },
              "required": ["name"],
              "additionalProperties": false
            }
          }
        },
        "required": ["id", "name", "kind"],
        "additionalProperties": false
      }
    },
    "tool_sets": {
      "description": "\"One of these, depending on your part\": tools of which a bike needs only one. Each option may name, with when, the bike data that says it fits; when reads only facts marked ask: never, so nothing is asked.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "name": { "description": "What the set is for, as the tools screen shows it.", "$ref": "common.schema.json#/$defs/text" },
          "tell_apart": { "description": "How the user tells which option fits, shown when the bike's data does not say.", "$ref": "common.schema.json#/$defs/text" },
          "options": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "properties": {
                "tool": { "$ref": "common.schema.json#/$defs/id" },
                "when": { "$ref": "common.schema.json#/$defs/condition" }
              },
              "required": ["tool"],
              "additionalProperties": false
            }
          }
        },
        "required": ["id", "name", "tell_apart", "options"],
        "additionalProperties": false
      }
    },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "name": { "$ref": "common.schema.json#/$defs/text" },
          "code": { "$ref": "common.schema.json#/$defs/text" },
          "safety": { "type": "boolean" }
        },
        "required": ["id", "name", "safety"],
        "additionalProperties": false
      }
    }
  },
  "required": ["tools"],
  "additionalProperties": false
}
