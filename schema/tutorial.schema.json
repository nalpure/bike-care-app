{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bike-app.invalid/schema/tutorial.schema.json",
  "title": "content/tutorials/<job>/tutorial.yaml: one tutorial per job",
  "$defs": {
    "leafCase": {
      "description": "when plus exactly one of include, exit.",
      "type": "object",
      "properties": {
        "when": { "$ref": "common.schema.json#/$defs/condition" },
        "include": { "type": "string", "pattern": "^cases/[a-z0-9-]+\\.yaml$" },
        "exit": { "$ref": "common.schema.json#/$defs/exit" }
      },
      "required": ["when"],
      "additionalProperties": false
    },
    "topCase": {
      "description": "when plus exactly one of include, exit, or cases (one nested branch, only where the order of work differs).",
      "type": "object",
      "properties": {
        "when": { "$ref": "common.schema.json#/$defs/condition" },
        "include": { "type": "string", "pattern": "^cases/[a-z0-9-]+\\.yaml$" },
        "exit": { "$ref": "common.schema.json#/$defs/exit" },
        "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/leafCase" } }
      },
      "required": ["when"],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "tutorial": {
      "type": "object",
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "job": { "$ref": "common.schema.json#/$defs/id" },
        "params": { "$ref": "common.schema.json#/$defs/params" },
        "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
        "choices": {
          "description": "Run choices (content/choices.yaml) this tutorial asks before the start.",
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
        },
        "parts": {
          "description": "Parts to have ready before the start (content/tools.yaml, parts).",
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/id" }
        },
        "checks": {
          "description": "Hands-off inspection calls that run before the chosen case's sequence, in every case. Declared once for the tutorial. One the user already answered in this session (in a diagnosis) is not shown again (hard rule 12).",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "inspect": { "$ref": "common.schema.json#/$defs/id" },
              "outcomes": { "$ref": "common.schema.json#/$defs/outcomes" }
            },
            "required": ["inspect", "outcomes"],
            "additionalProperties": false
          }
        },
        "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/topCase" } },
        "if_unknown": { "enum": ["ask"] }
      },
      "required": ["id", "job", "difficulty", "cases", "if_unknown"],
      "additionalProperties": false
    }
  },
  "required": ["tutorial"],
  "additionalProperties": false
}
