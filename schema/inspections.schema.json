{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bike-app.invalid/schema/inspections.schema.json",
  "title": "content/inspections.yaml: shared looks, listens and feels",
  "type": "object",
  "properties": {
    "inspections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "applies_when": { "$ref": "common.schema.json#/$defs/condition" },
          "title": {
            "description": "Short heading of the card, a few words, for example 'Look at the chain'.",
            "$ref": "common.schema.json#/$defs/text"
          },
          "hands_off": { "type": "boolean" },
          "minutes": { "$ref": "common.schema.json#/$defs/minutes" },
          "text": { "$ref": "common.schema.json#/$defs/text" },
          "default": {
            "description": "Tutorials only: the usual state. It gets no button; Next means it. Its outcome in every tutorial call is continue. Diagnoses and the routine check show every state.",
            "$ref": "common.schema.json#/$defs/id"
          },
          "question": {
            "description": "Tutorials only, with default: the short question above the other states ('Looks bent?').",
            "$ref": "common.schema.json#/$defs/text"
          },
          "tools": { "$ref": "common.schema.json#/$defs/toolUse" },
          "focus": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/nodeName" } },
          "show": {
            "description": "3D parts drawn plain; focus marks the small parts in colour; the 3D view hides every other part. A name goes in one of the two lists, not both.",
            "type": "array",
            "items": { "$ref": "common.schema.json#/$defs/nodeName" }
          },
          "view": { "$ref": "common.schema.json#/$defs/nodeName" },
          "animation": { "$ref": "common.schema.json#/$defs/animation" },
          "details": { "$ref": "common.schema.json#/$defs/details" },
          "states": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "items": {
              "type": "object",
              "properties": {
                "id": { "$ref": "common.schema.json#/$defs/id" },
                "label": { "$ref": "common.schema.json#/$defs/text" },
                "meaning": { "$ref": "common.schema.json#/$defs/text" },
                "leads_to": { "$ref": "common.schema.json#/$defs/leadsTo" }
              },
              "required": ["id", "label", "meaning"],
              "additionalProperties": false
            }
          }
        },
        "required": ["id", "title", "hands_off", "minutes", "text", "states"],        "additionalProperties": false,
        "dependentRequired": { "default": ["question"], "question": ["default"] }
      }
    }
  },
  "required": ["inspections"],
  "additionalProperties": false
}
