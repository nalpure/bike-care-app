{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bike-app.invalid/schema/ledger.schema.json",
  "title": "reviews/ledger.yaml: sign-offs of review units. Append only; write entries with npm run review -- sign.",
  "type": "object",
  "properties": {
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "unit": { "type": "string", "pattern": "^(card|tree|journey):.+$" },
          "hash": { "type": "string", "pattern": "^[0-9a-f]{12}$" },
          "role": { "enum": ["mechanic", "beginner"] },
          "by": { "type": "string", "minLength": 1 },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "verdict": { "enum": ["approved", "changes_requested"] },
          "note": { "type": "string" }
        },
        "required": ["unit", "hash", "role", "by", "date", "verdict"],
        "additionalProperties": false
      }
    }
  },
  "required": ["reviews"],
  "additionalProperties": false
}
