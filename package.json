{
  "name": "bike-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bike maintenance app: content, build tool and player",
  "scripts": {
    "check": "tsx tools/check.ts",
    "test": "node tools/run-tests.mjs",
    "walk": "tsx tools/walk.ts",
    "review": "tsx tools/review.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p player",
    "dev": "vite --config player/vite.config.ts",
    "build": "vite build --config player/vite.config.ts",
    "preview": "vite preview --config player/vite.config.ts",
    "test:e2e": "node player/e2e/run.mjs"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "three": "^0.187.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "playwright": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
