{
  "name": "bike-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bike maintenance app: content, build tool and player",
  "scripts": {
    "check": "tsx tools/check.ts",
    "test": "node tools/run-tests.mjs",
    "walk": "tsx tools/walk.ts",
    "review": "tsx tools/review.ts",
    "manifest": "tsx tools/export-3d-manifest.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p player",
    "dev": "vite --config player/vite.config.ts",
    "build": "vite build --config player/vite.config.ts",
    "preview": "vite preview --config player/vite.config.ts",
    "test:e2e": "tsx player/e2e/run.ts",
    "shots": "tsx player/e2e/slow.ts",
    "clean": "node tools/clean.mjs",
    "parts": "tsx tools/assets/library/build.ts",
    "parts:check": "tsx tools/assets/library/check.ts",
    "parts:mounts": "tsx tools/assets/measure/mounts.ts",
    "parts:rig": "tsx tools/assets/measure/rd.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "three": "^0.187.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "meshoptimizer": "1.1.1",
    "occt-import-js": "^0.0.23",
    "playwright": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
